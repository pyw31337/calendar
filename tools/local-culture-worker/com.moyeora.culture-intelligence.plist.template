<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.moyeora.culture-intelligence</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__REPO__/tools/local-culture-worker/run-culture-intelligence.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>2</integer>
    <key>Minute</key><integer>20</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/Moyeora/culture-intelligence.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/Moyeora/culture-intelligence.error.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
