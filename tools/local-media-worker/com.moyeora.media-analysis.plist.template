<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.moyeora.media-analysis</string>
  <key>ProgramArguments</key>
  <array>
    <string>/REPLACE/WITH/ABSOLUTE/PATH/run-media-worker.sh</string>
    <string>/REPLACE/WITH/ABSOLUTE/PATH/media-worker.json</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>900</integer>
  <key>ProcessType</key><string>Background</string>
  <!-- launchd does not inherit the interactive shell's Homebrew path. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key><string>/REPLACE/WITH/ABSOLUTE/PATH/media-analysis.log</string>
  <key>StandardErrorPath</key><string>/REPLACE/WITH/ABSOLUTE/PATH/media-analysis.error.log</string>
</dict>
</plist>
