rules_version = '2';

// Same trust model as firestore.rules: this project has no real user auth, so these
// rules validate shape/path only, not who the caller is. Chat and memo images are the
// only things stored here (see uploadChatImageAssets/uploadMemoImageAssets and their
// delete counterparts in index.html).
service firebase.storage {
  match /b/{bucket}/o {
    function isCalendarId(id) {
      return id.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    match /chatImages/{calendarId}/{fileName} {
      allow read: if isCalendarId(calendarId);
      allow write: if isCalendarId(calendarId)
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isCalendarId(calendarId);
    }

    match /memoImages/{calendarId}/{fileName} {
      allow read: if isCalendarId(calendarId);
      allow write: if isCalendarId(calendarId)
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isCalendarId(calendarId);
    }

    // Anniversary photos (uploadAnniversaryImageAssets, app-main.js) were never given a rule
    // here, so every upload attempt fell through to the deny-all catch-all below and silently
    // failed -- resolveImageUrls then fell back to the much-lower-resolution inline base64 path
    // (bounded by Firestore's document size, unlike a Storage-hosted image), which is why
    // anniversary photos looked degraded compared to chat/memo photos no matter how many times
    // they were re-uploaded or how much the compression quality was tuned.
    match /anniversaryImages/{calendarId}/{fileName} {
      allow read: if isCalendarId(calendarId);
      allow write: if isCalendarId(calendarId)
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isCalendarId(calendarId);
    }

    // Chat document attachments (pdf/office/text). Images still go through chatImages/.
    // Size ceiling is higher than photos because PDFs/office decks are commonly multi-MB.
    match /chatFiles/{calendarId}/{fileName} {
      allow read: if isCalendarId(calendarId);
      allow write: if isCalendarId(calendarId)
        && request.resource.size <= 20 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('application/msword')
          || request.resource.contentType.matches('application/vnd\\..*')
          || request.resource.contentType.matches('application/rtf')
          || request.resource.contentType.matches('text/.*')
          || request.resource.contentType.matches('application/octet-stream')
        );
      allow delete: if isCalendarId(calendarId);
    }

    // 밈 키보드 이미지 풀. calendarId로 나뉘지 않는 전역 공유 경로다 -- 모든 캘린더가 같은
    // 해시태그 인덱스를 읽는다. Firestore 쪽 문서(memePool/{memeId})는 admin-gated Cloud
    // Function으로만 쓸 수 있지만, 이 프로젝트에 실사용자 인증이 없어 Storage 쪽에서 "관리자만"을
    // 강제할 방법은 없다(다른 모든 업로드 경로와 동일한 신뢰 모델). 문서가 없는 고아 파일은
    // 아무도 읽지 않아 무해하다.
    match /memePool/{fileName} {
      allow get: if true;
      allow write: if request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
