rules_version = '2';

// Same trust model as firestore.rules: this project has no real user auth, so these
// rules validate shape/path only, not who the caller is. Chat images are the only
// thing stored here (see uploadChatImageAssets/deleteChatImageFromStorage in index.html).
service firebase.storage {
  match /b/{bucket}/o {
    function isCalendarId(id) {
      return id.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    match /chatImages/{calendarId}/{fileName} {
      allow read: if isCalendarId(calendarId);
      allow write: if isCalendarId(calendarId)
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isCalendarId(calendarId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
