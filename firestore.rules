rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isCalendarId(id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    function isCalendarDoc(calendarDocId) {
      return calendarDocId is string
        && calendarDocId.matches('^cal_[A-Za-z0-9_-]{1,64}$');
    }

    function hasValidCalendarShell(calendarDocId) {
      return request.resource.data.keys().hasOnly(['calendar', 'lastModified', 'revision'])
        && request.resource.data.calendar is map
        && isCalendarId(request.resource.data.calendar.id)
        && calendarDocId == 'cal_' + request.resource.data.calendar.id
        && request.resource.data.calendar.title is string
        && request.resource.data.calendar.title.size() > 0
        && request.resource.data.calendar.title.size() <= 80
        && (!('description' in request.resource.data.calendar) || request.resource.data.calendar.description is string)
        && (!('description' in request.resource.data.calendar) || request.resource.data.calendar.description.size() <= 160)
        && request.resource.data.calendar.participants is list
        && request.resource.data.calendar.participants.size() <= 80
        && request.resource.data.calendar.availabilities is list
        && request.resource.data.calendar.availabilities.size() <= 5000
        && (!('activityLogs' in request.resource.data.calendar) || request.resource.data.calendar.activityLogs is list)
        && (!('activityLogs' in request.resource.data.calendar) || request.resource.data.calendar.activityLogs.size() <= 5000)
        && (!('polls' in request.resource.data.calendar) || request.resource.data.calendar.polls is list)
        && (!('polls' in request.resource.data.calendar) || request.resource.data.calendar.polls.size() <= 100)
        // places/confirmedMeeting get a count cap only (not a full field-by-field lock like the
        // collections above) -- their shapes have grown new optional fields multiple times this
        // project's life (장소 categories, expense linkPreview, ...) without ever needing a rules
        // deploy, which is deliberate (see memos/anniversaries below for the same reasoning). The
        // cap alone still closes the actual risk audited here: an unbounded array pushing the
        // 1MiB document limit or racking up storage cost, which a shape-mismatch wouldn't do.
        && (!('places' in request.resource.data.calendar) || request.resource.data.calendar.places is list)
        && (!('places' in request.resource.data.calendar) || request.resource.data.calendar.places.size() <= 500)
        && (!('confirmedMeeting' in request.resource.data.calendar) || request.resource.data.calendar.confirmedMeeting is list)
        && (!('confirmedMeeting' in request.resource.data.calendar) || request.resource.data.calendar.confirmedMeeting.size() <= 500)
        && request.resource.data.lastModified is number
        && request.resource.data.revision is number;
    }

    function hasValidRevision(calendarDocId) {
      return !exists(/databases/$(database)/documents/calendars/$(calendarDocId))
        ? request.resource.data.revision == 1
        : request.resource.data.revision > resource.data.revision;
    }

    match /calendars/{calendarDocId} {
      // get (a specific, already-known ID) matches this app's share-link trust model; list does
      // not -- it would let anyone enumerate every calendar's ID (and, if it can be requested
      // with sub-collections, their content) without ever being given a link, which defeats
      // that model entirely. The admin dashboard's cross-calendar view used to rely on this
      // being open; it now goes through the listAllCalendars Cloud Function instead, which
      // checks the admin password server-side before returning anything (see functions/index.js).
      allow get: if isCalendarDoc(calendarDocId);
      allow list: if false;
      allow create, update: if isCalendarDoc(calendarDocId)
        && hasValidCalendarShell(calendarDocId)
        && hasValidRevision(calendarDocId);
      allow delete: if false;

      // Chat/opinion messages. Unlike the calendar document above, this collection has no
      // per-calendar document-count cap (Firestore doesn't support one in rules), so the
      // per-field size caps below are the only thing standing between this collection and
      // unbounded storage/quota growth. imageUrl's 400,000-char cap is a hard safety ceiling
      // (Firestore's 1MiB/doc limit), not the app's normal target -- assets/app-main.js's
      // compressImageToDataUrls keeps the base64-fallback-if-Storage-upload-fails path around
      // 48KB in the common case, since a message this large sits in every visitor's live "last
      // 100 messages" listener download on every future page load until it ages out.
      function hasValidMessageText(data) {
        return data.text is string && data.text.size() <= 5000;
      }
      // Cached OpenGraph preview embedded on a message when its text contains a URL (see
      // fetchLinkPreview / linkPreviews collection above) -- same field shape as that shared
      // cache doc, since it's just copied from there onto the message at send/edit time.
      function hasValidLinkPreview(data) {
        return !('linkPreview' in data) || data.linkPreview == null || (
          data.linkPreview is map
          && data.linkPreview.keys().hasOnly(['url', 'title', 'description', 'image', 'siteName', 'fetchedAt'])
          && data.linkPreview.url is string && data.linkPreview.url.size() <= 2000
          && data.linkPreview.title is string && data.linkPreview.title.size() <= 300
          && data.linkPreview.description is string && data.linkPreview.description.size() <= 500
          && data.linkPreview.image is string && data.linkPreview.image.size() <= 2000
          && data.linkPreview.siteName is string && data.linkPreview.siteName.size() <= 200
          && data.linkPreview.fetchedAt is number
        );
      }
      function hasValidMessageImages(data) {
        return (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 400000))
          && (!('thumbUrl' in data) || (data.thumbUrl is string && data.thumbUrl.size() <= 50000))
          // imageUrls/thumbUrls hold Firebase Storage download URLs (short strings) for
          // messages sent with more than one photo -- only ever written alongside imageUrl/
          // thumbUrl (see handleSendChatMessage), never used for the base64-fallback path.
          && (!('imageUrls' in data) || (data.imageUrls is list && data.imageUrls.size() <= 50))
          && (!('thumbUrls' in data) || (data.thumbUrls is list && data.thumbUrls.size() <= 50))
          // imageShareUrls caches the /calendar/?image={id} share URL generated per image (see
          // handlePromoteInlineChatImage in index.html) so a second click on the same image's
          // URL button in the lightbox doesn't need to regenerate it.
          && (!('imageShareUrls' in data) || (data.imageShareUrls is list && data.imageShareUrls.size() <= 50))
          // imageTags holds one free-text tag string per image, parallel-indexed to imageUrls/
          // thumbUrls (see handleSaveImageTags in index.html) -- entered from the Lightbox's
          // image-info panel and searched from GlobalSearchModal.
          && (!('imageTags' in data) || (data.imageTags is list && data.imageTags.size() <= 50))
          // directMediaTags stores the same hashtag text for an image rendered from a pasted
          // URL in the chat text. New clients store it as a URL-hash keyed map so each direct
          // media item can have independent tags; legacy string values are still readable.
          && (!('directMediaTags' in data) || (
            (data.directMediaTags is string && data.directMediaTags.size() <= 100)
            || (data.directMediaTags is map && data.directMediaTags.size() <= 50)
          ));
      }
      // Set at creation time (never patched afterward) to mark a message as auto-generated by
      // the gallery/meeting-photo upload flows rather than typed into the chat composer (see
      // handleUploadGalleryImages/handleAddMeetingPhotos) -- Lightbox uses it to show "갤러리에서
      // 업로드됨"/일정 사진 attribution instead of the default "채팅방에서 업로드됨".
      function hasValidUploadSource(data) {
        return !('uploadSource' in data) || (
          data.uploadSource is string
          && (data.uploadSource == 'gallery' || data.uploadSource == 'meeting')
        );
      }
      // Kakao-style reply quote: set only at creation time (never patched), a small snapshot of
      // the message being replied to -- just enough for the reply bubble to show a 1-2 line
      // quote card and jump back to the original (see ChatRoomView's reply button / handleSend-
      // ChatMessage's replyToPayload). id/participantId identify+link back to the original
      // message; text/imageCount are copied at reply time so the quote doesn't change if the
      // original is later edited or deleted.
      function hasValidReplyTo(data) {
        return !('replyTo' in data) || (
          data.replyTo is map
          && data.replyTo.keys().hasOnly(['id', 'participantId', 'text', 'imageCount'])
          && data.replyTo.id is string && data.replyTo.id.size() <= 200
          && data.replyTo.participantId is string && data.replyTo.participantId.size() <= 160
          && data.replyTo.text is string && data.replyTo.text.size() <= 300
          && data.replyTo.imageCount is number && data.replyTo.imageCount >= 0 && data.replyTo.imageCount <= 50
        );
      }
      function hasValidMessageMediaMetadataPatch() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['imageShareUrls', 'imageTags', 'directMediaTags'])
          && (!('imageShareUrls' in request.resource.data) || (request.resource.data.imageShareUrls is list && request.resource.data.imageShareUrls.size() <= 50))
          && (!('imageTags' in request.resource.data) || (request.resource.data.imageTags is list && request.resource.data.imageTags.size() <= 50))
          && (!('directMediaTags' in request.resource.data) || (
            (request.resource.data.directMediaTags is string && request.resource.data.directMediaTags.size() <= 100)
            || (request.resource.data.directMediaTags is map && request.resource.data.directMediaTags.size() <= 50)
          ));
      }

      match /messages/{messageId} {
        allow get, list: if isCalendarDoc(calendarDocId);
        allow create: if isCalendarDoc(calendarDocId)
          // imageTags/uploadSource were added here to let handleAddMeetingPhotos/
          // handleUploadGalleryImages auto-tag and attribute a message at creation time --
          // previously missing from this hasOnly() list, which made every single one of those
          // writes fail the security rules outright (Missing or insufficient permissions),
          // regardless of image count or size.
          && request.resource.data.keys().hasOnly(['participantId', 'text', 'timestamp', 'imageUrl', 'thumbUrl', 'imageUrls', 'thumbUrls', 'imageTags', 'uploadSource', 'linkPreview', 'replyTo'])
          && request.resource.data.participantId is string
          && request.resource.data.participantId.size() <= 160
          && request.resource.data.timestamp is number
          && hasValidMessageText(request.resource.data)
          && hasValidMessageImages(request.resource.data)
          && hasValidUploadSource(request.resource.data)
          && hasValidLinkPreview(request.resource.data)
          && hasValidReplyTo(request.resource.data);
        allow update: if isCalendarDoc(calendarDocId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'imageUrl', 'thumbUrl', 'imageUrls', 'thumbUrls', 'imageShareUrls', 'imageTags', 'directMediaTags', 'participantId', 'linkPreview'])
          && (
            hasValidMessageMediaMetadataPatch()
            || (
              hasValidMessageText(request.resource.data)
              && hasValidMessageImages(request.resource.data)
              && hasValidLinkPreview(request.resource.data)
              && (!('participantId' in request.resource.data) ||
                  (request.resource.data.participantId is string && request.resource.data.participantId.size() <= 160))
            )
          );
        allow delete: if isCalendarDoc(calendarDocId);
      }

      // Read-only denormalized index for date-specific meeting photos. It is maintained by the
      // server-side message trigger; clients never write index rows directly.
      match /meetingPhotoIndex/{photoId} {
        allow read: if isCalendarDoc(calendarDocId);
        allow write: if false;
      }

      // Web Push subscriptions. Allows browsers to register their endpoints for offline/background
      // pushes -- write-only from the client (index.html never reads this collection, only
      // .set()/.delete()). Actually sending a push is done server-side via the Admin SDK in
      // functions/index.js, which bypasses these rules entirely. get/list are denied because
      // endpoint + keys.auth/keys.p256dh are exactly what's needed to push arbitrary
      // spoofed-title notifications straight to that participant's browser -- letting every
      // fellow calendar guest read them would turn a feature meant for the app itself into an
      // open notification-spoofing vector.
      match /push_subscriptions/{subId} {
        // list/get: device management in Settings (endpoints are already writeable by clients)
        allow get, list: if isCalendarDoc(calendarDocId);
        allow create, update: if isCalendarDoc(calendarDocId)
          && request.resource.data.keys().hasOnly(['endpoint', 'keys', 'participantId', 'createdAt', 'updatedAt', 'userAgent', 'deviceId', 'deviceLabel', 'lastSeenAt', 'channels'])
          && request.resource.data.endpoint is string
          && request.resource.data.keys is map
          && request.resource.data.keys.auth is string
          && request.resource.data.keys.p256dh is string
          && request.resource.data.participantId is string
          && request.resource.data.participantId.size() <= 160
          && request.resource.data.createdAt is number
          && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is number)
          && (!('userAgent' in request.resource.data) || (request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 600))
          && (!('deviceId' in request.resource.data) || (request.resource.data.deviceId is string && request.resource.data.deviceId.size() <= 80))
          && (!('deviceLabel' in request.resource.data) || (request.resource.data.deviceLabel is string && request.resource.data.deviceLabel.size() <= 120))
          && (!('lastSeenAt' in request.resource.data) || request.resource.data.lastSeenAt is number)
          && (!('channels' in request.resource.data) || request.resource.data.channels is map);
        allow delete: if isCalendarDoc(calendarDocId);
      }

      // Collaborative memos. Allows participants to create, update, delete, and read notes in the
      // calendar. No keys().hasOnly() lock (the shape has grown new optional fields multiple
      // times -- tags, linkPreview, comments -- without ever needing a rules deploy, same
      // reasoning as places/confirmedMeeting above), but every field that holds free-form or
      // repeated client input gets a size cap so a single write can't be used to balloon this
      // per-entry subcollection (uncapped document count, like messages/activityLogs) with
      // oversized documents.
      function hasValidMemoShape(data) {
        return (!('id' in data) || (data.id is string && data.id.size() <= 200))
          && (!('participantId' in data) || (data.participantId is string && data.participantId.size() <= 160))
          && (!('title' in data) || (data.title is string && data.title.size() <= 200))
          && (!('text' in data) || (data.text is string && data.text.size() <= 5000))
          && (!('imageUrls' in data) || (data.imageUrls is list && data.imageUrls.size() <= 50))
          && (!('thumbUrls' in data) || (data.thumbUrls is list && data.thumbUrls.size() <= 50))
          && (!('tags' in data) || (data.tags is list && data.tags.size() <= 50))
          && (!('comments' in data) || (data.comments is list && data.comments.size() <= 200))
          // Denormalized copy of the newest comment's createdAt (see 최근 활동 / RECENT_MEMO_ACTIVITY_WINDOW_MS
          // in ui-memo-view.js) so a memo with fresh activity can be queried without loading its
          // whole comments array. No hasOnly() lock above means this was already writable before
          // this line existed -- it just adds the same type check every other optional field gets.
          && (!('lastCommentAt' in data) || data.lastCommentAt is number);
      }
      match /memos/{memoId} {
        allow read: if isCalendarDoc(calendarDocId);
        allow create, update: if isCalendarDoc(calendarDocId) && hasValidMemoShape(request.resource.data);
        allow delete: if isCalendarDoc(calendarDocId);
      }

      // Collaborative anniversaries (Yearly repeating solar/lunar events & D-days). Same
      // no-hasOnly-but-size-capped reasoning as memos above.
      function hasValidAnniversaryShape(data) {
        return (!('id' in data) || (data.id is string && data.id.size() <= 200))
          && (!('title' in data) || (data.title is string && data.title.size() <= 200))
          && (!('date' in data) || (data.date is string && data.date.size() <= 20))
          && (!('targetDate' in data) || (data.targetDate is string && data.targetDate.size() <= 20));
      }
      match /anniversaries/{anniversaryId} {
        allow read: if isCalendarDoc(calendarDocId);
        allow create, update: if isCalendarDoc(calendarDocId) && hasValidAnniversaryShape(request.resource.data);
        allow delete: if isCalendarDoc(calendarDocId);
      }

      // User-registered culture/festival archive cards (보관함 > 컨텐츠 등록). Merged into the
      // crawled culture-performances / culture-festivals snapshots client-side. Same loose
      // size-capped shape style as memos/anniversaries -- fields grow with form polish.
      function hasValidCustomCultureItemShape(data) {
        return (!('id' in data) || (data.id is string && data.id.size() <= 200))
          && (!('title' in data) || (data.title is string && data.title.size() <= 200))
          && (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 20))
          && (!('endDate' in data) || (data.endDate is string && data.endDate.size() <= 20))
          && (!('kind' in data) || (data.kind is string && data.kind.size() <= 40))
          && (!('description' in data) || (data.description is string && data.description.size() <= 4000));
      }
      match /customCultureItems/{itemId} {
        allow read: if isCalendarDoc(calendarDocId);
        allow create, update: if isCalendarDoc(calendarDocId) && hasValidCustomCultureItemShape(request.resource.data);
        allow delete: if isCalendarDoc(calendarDocId);
      }

      // Registered places (장소 지도). Migrated out of the calendar document's embedded `places`
      // array for the same reason activityLogs was (see below): an unbounded-growth array on the
      // calendar doc gets re-downloaded on every single realtime update to that doc, for every
      // connected client, regardless of relevance. The embedded field still exists on the
      // calendar document (count-capped at 500, see hasValidCalendarShell) for calendars not yet
      // self-migrated -- see unionPlaces/getCalendarPlaces in assets/app-main.js. Doc ID is the
      // place's own `id` (client-generated, see normalizePlaces), same keyed-by-own-id pattern as
      // memos. No hasOnly() lock, same reasoning as memos/anniversaries above.
      function hasValidPlaceShape(data) {
        return (!('id' in data) || (data.id is string && data.id.size() <= 200))
          && (!('name' in data) || (data.name is string && data.name.size() <= 200))
          && (!('address' in data) || (data.address is string && data.address.size() <= 300))
          && (!('memo' in data) || (data.memo is string && data.memo.size() <= 2000))
          && (!('categoryId' in data) || (data.categoryId is string && data.categoryId.size() <= 100));
      }
      match /places/{placeId} {
        allow read: if isCalendarDoc(calendarDocId);
        allow create, update: if isCalendarDoc(calendarDocId) && hasValidPlaceShape(request.resource.data);
        allow delete: if isCalendarDoc(calendarDocId);
      }

      // 라이트박스 사진 댓글 (인물/장소와 무관하게 사진 자체에 다는 댓글). 사진은 채팅/메모/일정
      // 사진첩/기념일 등 여러 파이프라인에 흩어져 있고 그 자체로 독립 문서가 아니므로, 댓글을
      // 붙일 곳은 사진의 안정적인 식별자(mediaKey/refKey, getMediaIdentityKeys가 항상 만들어줌)를
      // 문서 id로 쓰는 이 별도 컬렉션뿐이다. 댓글이 실제로 달린 사진만 문서가 생기므로(빈 배열은
      // 절대 안 씀, 아래 app-firebase-data.js savePhotoComments 참고) 컬렉션 크기는 항상
      // "댓글이 달린 사진 수"에 비례한다.
      function isValidPhotoCommentDocId(id) {
        return id is string && id.matches('^[A-Za-z0-9_:.-]{1,300}$');
      }
      function hasValidPhotoCommentShape(data) {
        return (!('comments' in data) || (data.comments is list && data.comments.size() <= 200))
          && (!('updatedAt' in data) || data.updatedAt is number);
      }
      match /photoComments/{photoKey} {
        allow read: if isCalendarDoc(calendarDocId);
        allow create, update: if isCalendarDoc(calendarDocId)
          && isValidPhotoCommentDocId(photoKey)
          && hasValidPhotoCommentShape(request.resource.data);
        allow delete: if isCalendarDoc(calendarDocId);
      }

      // Confirmed meeting dates + their 회비 정산 (settlement) data. Same migration reasoning as
      // places above. Doc ID is the entry's own `date` string (unique per calendar already, since
      // getConfirmedMeetings/handleConfirmMeeting key off date) rather than a generated id.
      function isValidConfirmedMeetingDocId(id) {
        return id is string && id.matches('^\\d{4}-\\d{2}-\\d{2}$');
      }
      function hasValidConfirmedMeetingShape(data) {
        return (!('date' in data) || (data.date is string && data.date.size() <= 20))
          && (!('note' in data) || (data.note is string && data.note.size() <= 1000))
          && (!('expenses' in data) || (data.expenses is list && data.expenses.size() <= 200))
          && (!('photos' in data) || (data.photos is list && data.photos.size() <= 300));
      }
      match /confirmedMeetings/{meetingId} {
        allow read: if isCalendarDoc(calendarDocId);
        allow create, update: if isCalendarDoc(calendarDocId)
          && isValidConfirmedMeetingDocId(meetingId)
          && hasValidConfirmedMeetingShape(request.resource.data);
        allow delete: if isCalendarDoc(calendarDocId);
      }

      // Activity log audit trail. Used to embed as a growing array on the calendar document
      // itself, which had no de-duplication and was the single biggest long-term threat to the
      // document's 1MiB size limit -- moved to its own subcollection (one document per entry,
      // same pattern as messages above) so it has no per-document size ceiling to fight. Entries
      // are immutable once written (create + point-in-time-recovery delete only, no update).
      match /activityLogs/{logId} {
        allow get, list: if isCalendarDoc(calendarDocId);
        allow create, update: if isCalendarDoc(calendarDocId)
          && request.resource.data.keys().hasOnly(['id', 'calendarId', 'participantId', 'date', 'action', 'note', 'timestamp'])
          && request.resource.data.id is string
          && request.resource.data.id.size() <= 200
          && request.resource.data.calendarId is string
          && request.resource.data.participantId is string
          && request.resource.data.participantId.size() <= 160
          && request.resource.data.date is string
          && request.resource.data.date.size() <= 20
          && request.resource.data.action is string
          && request.resource.data.note is string
          // 320, not 200 -- normalizeActivityLog (the actual function that builds every activity
          // log entry before it's written) caps note at 320 chars via sanitizeText, so a 200 cap
          // here would silently reject (and, since writeActivityLogsToFirestore is fire-and-forget,
          // silently drop) any entry whose note landed in the 201-320 range -- the exact same class
          // of bug as the messages/{messageId} hasOnly() mismatch fixed above, just smaller blast
          // radius (an audit-trail entry going missing, not a whole photo upload failing).
          && request.resource.data.note.size() <= 320
          && request.resource.data.timestamp is number;
        allow update: if false;
        allow delete: if isCalendarDoc(calendarDocId);
      }
    }

    // Stores the hashed admin-dashboard password. Used to be readable/writable by shape only
    // (see index.html AdminLoginGate) -- any client could overwrite passwordHash with one of
    // their own choosing and log in as admin, no actual password needed. It's now managed
    // entirely by the adminVerifyPassword/listAllCalendars/adminChangePassword Cloud Functions
    // (functions/index.js), which use the Admin SDK and so don't need this doc open to clients
    // at all; the login screen and password-change form both call those functions instead of
    // touching this document directly.
    match /appConfig/adminAuth {
      allow get, list: if false;
      allow create, update, delete: if false;
    }

    // Image sharing for /calendar/?image={id}. Two document shapes are written by the client
    // (see createImageShareDocument in index.html):
    //  - a lightweight pointer (source == 'message') for images that already live on a sent
    //    chat message -- resolved at read time via messages/{messageId} instead of duplicating
    //    the image data here.
    //  - a legacy/fallback shape that embeds the image itself as an inline base64 data URL,
    //    used only when there is no source chat message to point at (or it couldn't be
    //    uploaded to Storage). Matches the client-side shareId format check
    //    (/^img_[A-Za-z0-9_-]{3,180}$/ in fetchImageShareDocument).
    match /imageShares/{shareId} {
      allow get: if shareId is string && shareId.matches('^img_[A-Za-z0-9_-]{3,180}$');
      allow list: if false;

      function isValidMessageSharePointer(data) {
        return data.keys().hasOnly(['id', 'calendarId', 'source', 'messageId', 'imageIndex', 'thumbUrl', 'createdAt'])
          && data.source == 'message'
          && data.messageId is string
          && data.messageId.size() > 0
          && data.messageId.size() <= 200
          && data.imageIndex is number;
      }

      function isValidInlineDataShare(data) {
        return data.keys().hasOnly(['id', 'calendarId', 'imageUrl', 'thumbUrl', 'messageId', 'imageIndex', 'createdAt'])
          && data.imageUrl is string
          && data.imageUrl.size() <= 450000
          && data.imageUrl.matches('^data:image/.*')
          && data.messageId is string
          && data.messageId.size() <= 200
          && data.imageIndex is number;
      }

      allow create: if request.resource.data.id == shareId
        && request.resource.data.calendarId is string
        && isCalendarId(request.resource.data.calendarId)
        && request.resource.data.thumbUrl is string
        && request.resource.data.thumbUrl.size() <= 60000
        && request.resource.data.createdAt is number
        && (isValidMessageSharePointer(request.resource.data) || isValidInlineDataShare(request.resource.data));
      allow update, delete: if false;
    }

    // Shared, service-wide link-preview (OpenGraph) cache. Keyed by a deterministic hash of the
    // URL (see hashUrlForCache in index.html) rather than the raw URL, since Firestore document
    // IDs can't contain '/'. Populated once per URL on first fetch from the Peekalink API and
    // reused by every calendar/user afterwards -- see fetchLinkPreview in index.html. No 'list'
    // access: any client that already knows a URL can hash it and GET that one doc, but nobody
    // can enumerate every URL ever shared across every calendar.
    match /linkPreviews/{urlHash} {
      allow get: if urlHash is string && urlHash.matches('^[a-f0-9]{1,16}$');
      allow list: if false;
      allow create, update: if urlHash is string && urlHash.matches('^[a-f0-9]{1,16}$')
        && request.resource.data.keys().hasOnly(['url', 'title', 'description', 'image', 'siteName', 'fetchedAt'])
        && request.resource.data.url is string && request.resource.data.url.size() <= 2000
        && request.resource.data.title is string && request.resource.data.title.size() <= 300
        && request.resource.data.description is string && request.resource.data.description.size() <= 500
        && request.resource.data.image is string && request.resource.data.image.size() <= 2000
        && request.resource.data.siteName is string && request.resource.data.siteName.size() <= 200
        && request.resource.data.fetchedAt is number;
      allow delete: if false;
    }

    // Aggregate counter for the linkPreviews cache above, read by the admin dashboard's
    // "외부 서비스 연동 현황" panel so it can show cache size without a costly full-collection
    // read (list access on linkPreviews itself is intentionally disabled).
    // hourlyUsageBucket/hourlyUsageCount track real Peekalink API calls against its 50/hour
    // free-plan rate limit for the panel's usage gauge -- written via separate merge() calls
    // from cachedCount/updatedAt, so fields are validated individually rather than all-required.
    match /appConfig/linkPreviewStats {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['cachedCount', 'updatedAt', 'hourlyUsageBucket', 'hourlyUsageCount'])
        && (!('cachedCount' in request.resource.data) || (request.resource.data.cachedCount is number && request.resource.data.cachedCount >= 0))
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is number)
        && (!('hourlyUsageBucket' in request.resource.data) || request.resource.data.hourlyUsageBucket is number)
        && (!('hourlyUsageCount' in request.resource.data) || (request.resource.data.hourlyUsageCount is number && request.resource.data.hourlyUsageCount >= 0));
      allow delete: if false;
    }

    // Daily Kakao Local (지도 검색) API call count, for the admin dashboard's usage panel.
    // Written only by kakaoLocalSearchProxy via the Admin SDK (see functions/index.js), which
    // bypasses these rules entirely -- so unlike linkPreviewStats above, no client write path is
    // needed here at all; this only ever needs to be read.
    match /appConfig/kakaoLocalSearchStats {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Monthly Google Places API call count (해외 장소 검색 폴백), for the admin dashboard's usage
    // panel. Written only by googlePlacesSearchProxy via the Admin SDK (see functions/index.js),
    // same reasoning as kakaoLocalSearchStats above -- no client write path needed.

    // Shared weather snapshot cache (1h TTL enforced client-side).
    // Key = lat_lon rounded to 2 decimals, e.g. "37.57_126.98".
    // Read: public (same as calendar weather badge). Write: small validated payload only.
    match /weatherCache/{cellId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if cellId is string
        && cellId.size() <= 32
        && request.resource.data.keys().hasOnly(['temp', 'code', 'lat', 'lon', 'fetchedAt', 'name'])
        && request.resource.data.temp is number
        && request.resource.data.temp >= -80
        && request.resource.data.temp <= 60
        && request.resource.data.code is number
        && request.resource.data.code >= 0
        && request.resource.data.code <= 200
        && request.resource.data.lat is number
        && request.resource.data.lon is number
        && request.resource.data.fetchedAt is number
        && request.resource.data.fetchedAt > 0
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 80));
      allow delete: if false;
    }

    match /appConfig/googlePlacesSearchStats {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
