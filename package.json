{
  "name": "gather-calendar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-dist-syntax.mjs && node scripts/copy-static-to-dist.mjs && node scripts/check-dist-share-scope.mjs",
    "lint": "eslint . --report-unused-disable-directives",
    "test": "node --test 'test/**/*.test.mjs'",
    "preview": "vite preview",
    "og:generate": "node scripts/generate-og-pages.mjs",
    "regression:test": "node scripts/regression-check.mjs",
    "safety:test": "node scripts/firebase-safety-tests.mjs",
    "check:asset-mirrors": "node scripts/check-asset-mirrors.mjs",
    "check:size-budget": "node scripts/check-size-budget.mjs",
    "check:tab-wiring": "node scripts/check-tab-wiring.mjs",
    "stress:firebase": "node scripts/firebase-live-stress-tests.mjs",
    "e2e:firebase-write": "node scripts/firebase-live-stress-tests.mjs",
    "e2e:settlement-write": "node scripts/firebase-settlement-write-test.mjs",
    "e2e:full-crud": "node scripts/firebase-full-crud-tests.mjs",
    "ops:audit": "node scripts/firebase-ops-audit.mjs",
    "ops:media-audit": "node scripts/firebase-media-audit.mjs",
    "ops:integrity-audit": "node scripts/audit-media-integrity.mjs",
    "ops:daily-report": "node scripts/ops-daily-report.mjs",
    "ops:integrity-repair": "node scripts/repair-media-integrity.mjs",
    "ops:repair-tag-divergence": "node scripts/repair-tag-divergence.mjs",
    "ops:apply-tag-suggestions": "node scripts/apply-tag-suggestions.mjs",
    "ops:restore-archive-deleted-photos": "node scripts/restore-archive-deleted-photos.mjs",
    "test:functions:emulator": "npx --yes firebase-tools@14 emulators:exec --project demo-moyeora --only firestore,storage \"node --test functions/test/media-commands.emulator.test.js functions/test/media-auto-tags.emulator.test.js functions/test/rules-image-geo.emulator.test.js functions/test/rules-likes.emulator.test.js functions/test/photo-comment-items.emulator.test.js\"",
    "ops:gallery-contract-audit": "node scripts/firebase-gallery-contract-audit.mjs",
    "ops:repair-meeting-photo-refs": "node scripts/firebase-repair-meeting-photo-refs.mjs",
    "ops:export": "node scripts/firebase-export-prod.mjs",
    "ops:import": "node scripts/firebase-import-prod.mjs",
    "ops:clean-stress": "node scripts/firebase-clean-stress-docs.mjs",
    "restore:rehearsal": "node scripts/restore-rehearsal.mjs",
    "smoke:live": "node scripts/live-smoke-check.mjs",
    "smoke:browser": "node scripts/browser-smoke-test.mjs",
    "smoke:browser:live": "CALENDAR_SMOKE_BLOCK_PRODUCTION_DATA=0 node scripts/browser-smoke-test.mjs",
    "smoke:browser:all": "npm run smoke:browser && CALENDAR_SMOKE_BROWSER=firefox npm run smoke:browser && CALENDAR_SMOKE_BROWSER=webkit npm run smoke:browser",
    "check:required-symbols": "node scripts/check-required-symbols.mjs",
    "check:dead-globals": "node scripts/check-dead-globals.mjs",
    "check:isolation": "node scripts/check-calendar-isolation.mjs",
    "check:share-urls": "node scripts/check-share-urls.mjs",
    "check:design-rules": "node scripts/check-design-rules.mjs",
    "check:design-system": "node scripts/check-design-system.mjs",
    "check:live-source": "node scripts/check-live-source-guards.mjs",
    "check:dist-budget": "node scripts/check-dist-budget.mjs",
    "check:dist-share-scope": "node scripts/check-dist-share-scope.mjs",
    "check:mobile-checklist": "node scripts/check-mobile-deploy-checklist.mjs",
    "check:ci-scenarios": "node scripts/check-ci-scenarios.mjs",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "check:workflow-scope": "node scripts/check-workflow-scope.mjs",
    "check:architecture-budget": "node scripts/check-architecture-budget.mjs",
    "check:architecture-boundaries": "node scripts/check-architecture-boundaries.mjs",
    "check:app-main-inventory": "node scripts/check-app-main-inventory.mjs",
    "check:lint-budget": "node scripts/check-lint-budget.mjs",
    "check:rules-safety": "node scripts/check-rules-safety.mjs",
    "check:egress-safety": "node scripts/check-egress-safety.mjs",
    "check:accessibility-safety": "node scripts/check-accessibility-safety.mjs",
    "check:helper-calls": "node scripts/audit-helper-calls.mjs",
    "check:npm-audit": "node scripts/check-npm-audit.mjs",
    "lint:changed": "node scripts/lint-changed.mjs",
    "check:all": "npm run check:secrets && npm run lint && npm run test && npm run lint:changed && npm run check:lint-budget && npm run check:rules-safety && npm run check:egress-safety && npm run check:accessibility-safety && npm run check:required-symbols && npm run check:dead-globals && npm run check:helper-calls && npm run check:asset-mirrors && npm run check:isolation && npm run check:share-urls && npm run check:design-rules && npm run check:design-system && npm run check:live-source && npm run check:size-budget && npm run check:tab-wiring && npm run check:workflow-scope && npm run check:architecture-boundaries && npm run check:architecture-budget && npm run check:app-main-inventory && npm run check:mobile-checklist && npm run check:ci-scenarios && npm run check:npm-audit",
    "predeploy": "npm run check:all && npm run safety:test && npm run build && npm run check:dist-budget"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "canvas-confetti": "^1.9.2",
    "exifr": "^7.1.3",
    "korean-lunar-calendar": "^0.4.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.344.0",
    "maplibre-gl": "^6.9.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "playwright": "1.56.1",
    "terser": "^5.39.0",
    "vite": "^8.2.2"
  }
}
